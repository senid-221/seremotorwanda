PORT=3000
HOST=0.0.0.0
PUBLIC_URL=https://your-domain.rw
# Neon Postgres. Dashboard -> your project -> Connect -> copy the pooled connection string. Leave
# DATABASE_SSL empty: the sslmode in the URL decides. Set DATABASE_SSL=disable only for a local test server.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/DBNAME?sslmode=require
DATABASE_SSL=
DATABASE_POOL_MAX=10

# Document storage (AWS S3, Cloudflare R2, Backblaze B2 or MinIO). The bucket stays private: riders
# upload with a signed PUT, admins read with a signed GET, and the keys never leave the server.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
S3_SIGNED_URL_TTL_SECONDS=300
S3_MAX_UPLOAD_MB=8

# 64-char hex, required. Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SESSION_HOURS=720
PLATFORM_COMMISSION_PERCENT=5

# Paystack (card / bank). Dashboard -> Settings -> API keys. sk_test_ for testing, sk_live_ for production.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# MTN MoMo Collections API v3. MOMO_BASE_URL is the host MTN gives you when your app is approved
# (sandbox and live differ), e.g. https://<their-host>/momo-sandbox2/whm/api/v3 — it is not guessable.
# USER_ID / PRIMARY_KEY / API_KEY / SUBSCRIPTION_KEY come from the MoMo developer portal (API Products -> your app).
MOMO_BASE_URL=
MOMO_USER_ID=
MOMO_SUBSCRIPTION_KEY=
MOMO_PRIMARY_KEY=
MOMO_API_KEY=
MOMO_PRODUCT_ID=
MOMO_CALLBACK_BASE=

# Login OTP delivery — the code has to reach the SIM, not the server log. Pick one provider:
#   africastalking  SMS_PROVIDER_KEY = the Api key from dashboard.africastalking.com -> Settings -> API keys,
#                   SMS_USERNAME     = that same account username.
#   twilio          SMS_PROVIDER_KEY = the auth token, SMS_TWILIO_ACCOUNT_SID (or SMS_USERNAME) = the account SID.
#   generic         SMS_PROVIDER_URL = your gateway; the call is POST JSON {to,from,message}
#                   with "Authorization: Bearer <SMS_PROVIDER_KEY>".
# Leave the key empty and the server stays in dev mode: the code only reaches the console, and a real
# login is impossible for a customer. Never ship dev mode.
SMS_PROVIDER=africastalking
SMS_PROVIDER_KEY=
SMS_USERNAME=
SMS_TWILIO_ACCOUNT_SID=
SMS_PROVIDER_URL=
SMS_SENDER_ID=SEREMOTO
SMS_TIMEOUT_MS=10000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_SECONDS=30
OTP_MAX_PER_HOUR=8

# Development only. With no SMS provider the code is printed to the server console; setting OTP_ECHO=1 also
# returns it in the /api/auth/otp/send response, which lets the test suite sign in. Never set this in
# production — anyone who can read that response could log in as anyone.
OTP_ECHO=

# Credential checks against the real registers. The digit laws themselves are not configurable:
# phone 10 digits, national ID 16 digits, TIN 9 digits. Everything below is OFF until you hold the
# provider contract — with no key the server format-checks the value and never claims a register
# confirmed it. /api/health shows which of these are live.
#
# RRA taxpayer lookup. RRA issues the host, the auth mode and the answer field names when your
# taxpayer account is enabled for the e-services API; the path defaults to /customers/selectCustomer.
# RRA_TIN_STYLE=query means "?<RRA_TIN_FIELD>=<tin>"; use "json" to POST it instead.
RRA_BASE_URL=
RRA_TIN_PATH=/customers/selectCustomer
RRA_TIN_STYLE=query
RRA_TIN_FIELD=tin
RRA_API_KEY=
RRA_USERNAME=
RRA_PASSWORD=
# RRA_VALID_FIELD names the field that says "this taxpayer exists" and RRA_NAME_FIELD the taxpayer's
# name. Leave them empty and the server reads the answer by shape — if it cannot read it, it reports
# "unavailable" rather than guessing a pass.
RRA_VALID_FIELD=
RRA_NAME_FIELD=
RRA_TIMEOUT_MS=10000

# National ID match — NIDA's own API, or peleza.com, or any contractor that returns match/no-match.
ID_PROVIDER=
ID_CHECK_URL=
ID_CHECK_KEY=
ID_USERNAME=
ID_PASSWORD=
ID_MATCH_FIELD=
ID_NAME_FIELD=
ID_TIMEOUT_MS=10000

# Phone number check — numverify (apilayer.com). One access key from the apilayer dashboard; the
# digits are screened with it BEFORE an OTP is sent, so a number that cannot exist costs no SMS credit.
# Free-plan keys that reject the HTTPS gateway: set NUMVERIFY_BASE_URL=http://apilayer.net/api
NUMVERIFY_ACCESS_KEY=
NUMVERIFY_BASE_URL=https://api.apilayer.com/numverify
NUMVERIFY_TIMEOUT_MS=10000

# Subscriber / live-network check on the phone number (an HLR lookup from the same vendors).
# Used only when NUMVERIFY_ACCESS_KEY is empty.
PHONE_CHECK_URL=
PHONE_CHECK_KEY=
PHONE_CHECK_TIMEOUT_MS=10000

# 1 = an application cannot be filed until every configured check has returned a verdict. With 0,
# a provider outage is recorded on the application as "unavailable" and an admin can re-run it.
KYC_STRICT=

# Google sign-in. Google Cloud Console -> APIs & Services -> Credentials -> Create credentials ->
# OAuth client ID -> Web application. Add your site origin to "Authorized JavaScript origins",
# then paste the client ID here (ends in .apps.googleusercontent.com). Leave empty to disable the button.
GOOGLE_CLIENT_ID=
GOOGLE_CERTS_URL=https://www.googleapis.com/oauth2/v3/certs

# The Rwandan number of the SERE Moto admin. The first time this number verifies an OTP it is granted
# admin access, which is what unlocks /admin and the approval endpoints. Local format, e.g. 0788123456.
ADMIN_PHONE=

# Motorcycle fares are set by law, not by the rider: RURA Board Decision 03/BD/RD-TRP/2021 as adjusted in
# August 2022. Change these only when RURA publishes a new decision — the server prices every moto trip
# from this table and ignores price_per_km for a moto.
FARE_MOTO_FIRST_KM=2
FARE_MOTO_MIN_RWF=400
FARE_MOTO_MID_BAND_KM=40
FARE_MOTO_RATE_RWF=117
FARE_MOTO_LONG_RATE_RWF=187
FARE_FREE_WAIT_MIN=10
FARE_WAIT_RWF_PER_MIN=21

# Journey distance from OpenStreetMap (no key needed). Nominatim's usage policy wants a User-Agent that
# identifies the app, so set OSM_USER_AGENT to something they can reach you at.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=SEREMoto/1.0 (support@sere.moto)
OSM_TIMEOUT_MS=8000

# How old a rider's GPS fix may be before the app stops calling them "live" and nearby.
LIVE_LOCATION_SECONDS=180
